---
// Every page of the site: the head (description, canonical and `hreflang` links, Open Graph, the
// icons, the font preload and the stylesheet), the skip link, the top bar, the page's own
// sections in the default slot, and the footer.
import "../../site.css";

import Footer from "../components/Footer.astro";
import TopBar from "../components/TopBar.astro";
import { asset, fontUrl } from "../lib/assets";
import { strings, type PageContext } from "../lib/context";
import { LANGUAGES, pageUrl, siteUrl } from "../lib/site";

interface Props {
  ctx: PageContext;
  title: string;
  description: string;
}

const { ctx, title, description } = Astro.props;
const url = pageUrl(ctx.lang, ctx.page);
const ogImage = siteUrl(asset("og.png"));
const otherLanguages = LANGUAGES.filter((lang) => lang !== ctx.lang);
---

<!doctype html>
<html lang={ctx.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {LANGUAGES.map((lang) => <link rel="alternate" hreflang={lang} href={pageUrl(lang, ctx.page)} />)}
    <link rel="alternate" hreflang="x-default" href={pageUrl(LANGUAGES[0], ctx.page)} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Begitra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ctx.s.meta.ogAlt} />
    <meta property="og:locale" content={ctx.s.locale} />
    {
      otherLanguages.map((lang) => (
        <meta property="og:locale:alternate" content={strings[lang].locale} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href={asset("icon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset("apple-touch-icon.png")} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">{ctx.s.skip}</a>
    <TopBar ctx={ctx} />
    <main id="main">
      <slot />
    </main>
    <Footer ctx={ctx} />
  </body>
</html>
